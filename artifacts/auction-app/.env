# Vite dev server (browser URL is http://localhost:<PORT>)
PORT=5173

# App base path (usually "/" locally)
BASE_PATH=/

# API port for Vite proxy — must match api-server PORT unless you set API_PROXY_TARGET
API_SERVER_PORT=8080

# Optional: full URL override instead of API_SERVER_PORT
# API_PROXY_TARGET=http://127.0.0.1:8080
